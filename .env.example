# Copy to .env and fill in values. Never commit .env to git.

# Databricks workspace
DATABRICKS_HOST=https://adb-xxxxxxxxxxxx.azuredatabricks.net
DATABRICKS_TOKEN=dapi...

# SQL Warehouse HTTP path (Databricks → SQL Warehouses → your warehouse → Connection Details)
DATABRICKS_SQL_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx

# Mapbox public token (mapbox.com → Account → Tokens)
MAPBOX_TOKEN=pk.eyJ1...

# Google OAuth — required to enable login (via the shared surus-auth package)
# Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID (Web application)
# Add https://{your-domain}/auth/callback as an authorized redirect URI
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Comma-separated list of allowed email domains (e.g. surusenterprises.com,example.com).
# Leaving this and ALLOWED_EMAILS empty admits ANY Google account.
# The older name GOOGLE_WORKSPACE_DOMAIN is still read when this is unset.
ALLOWED_EMAIL_DOMAIN=surusenterprises.com
APP_URL=https://your-app-domain.com
# Required — app will not start without this. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Optional
# Individual addresses outside the allowed domains (comma-separated)
ALLOWED_EMAILS=
# First admins (comma-separated). Everyone else is managed on /admin.
ADMIN_BOOTSTRAP_EMAILS=
QUERY_CACHE_SECONDS=300
DASH_DEBUG=false

# Optional — override source tables without a code change.
# Leave unset to use the defaults baked into data/queries.py.
DATABRICKS_CONTACT_ANALYSIS_TABLE=universal.bitables.contact_analysis_dash
DATABRICKS_CONTACTS_TABLE=universal.bitables.contact_pull_trimmed
DATABRICKS_BOUNDARIES_TABLE=geo_assets.boundaries.cb_2025_500k
DATABRICKS_GOALS_TABLE=universal.bitables.clp_goals_source
DATABRICKS_FD_SOURCE_TABLE=universal.bitables.fd_source
DATABRICKS_RECENT_EVENT_TABLE=universal.bitables.recent_event_source
DATABRICKS_GOAL_CALENDAR_ORG_TABLE=universal.bitables.nation_goal_calendar_org

# ---- Roles, usage tracking and /admin (surus-auth v2) ----------------------
# Leave PLATFORM_SCHEMA unset locally (with APP_ENV not prod) to keep roles and
# activity in memory only: nothing touches Databricks.
# This app's key in universal.ops.apps (set in platform_setup.py; listed for reference).
APP_ID=central_pm
# prod | dev | test | dev_<name>. Unset means dev, never prod.
APP_ENV=dev_yourname
PLATFORM_SCHEMA=universal.ops
# The platform tables reuse the Databricks variables above: DATABRICKS_HOST,
# DATABRICKS_SQL_HTTP_PATH (must be a SQL warehouse, not a cluster) and
# DATABRICKS_TOKEN, so the writes run as that token's owner. surus-auth also
# accepts DATABRICKS_CLIENT_ID + DATABRICKS_CLIENT_SECRET (the app's own service
# principal), but a token wins when both are set, and data/queries.py only
# knows the token: switching to the principal means changing both.

# ---- Build only (Railway) ----------------------------------------------------
# read-only GitHub token that can read surusgop/surus-auth
GH_PAT=
